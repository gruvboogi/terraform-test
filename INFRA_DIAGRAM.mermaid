graph TB
    %% Internet is now outside the region
    Internet((Internet))

    subgraph OCI_Region ["OCI Region: ap-chuncheon-1"]
        style OCI_Region fill:#f9f9f9,stroke:#333,stroke-width:2px

        subgraph Compartment ["Compartment: terraform-test"]
            style Compartment fill:#ffffff,stroke:#d0021b,stroke-width:2px,stroke-dasharray: 5 5

            subgraph VCN ["VCN: terraform-test-vcn<br/>(192.0.0.0/16)"]
                style VCN fill:#e6f7ff,stroke:#007bff,stroke-width:2px

                %% Resources
                IGW(Internet Gateway<br/>test-igw)
                style IGW fill:#faad14,stroke:#333,color:black

                subgraph Public_Subnet ["Public Subnet<br/>(192.0.1.0/24)"]
                    style Public_Subnet fill:#d9f7be,stroke:#52c41a,stroke-width:2px
                    RT_Public[Route Table: public-rt]
                    style RT_Public fill:#52c41a,stroke:#333,color:white
                end

                %% Inactive/Removed Resources
                NAT_GW(NAT Gateway<br/>*Destroyed*)
                Priv_Sub(Private Subnet<br/>*Destroyed*)
                classDef removed fill:#eee,stroke:#999,stroke-dasharray: 5 5, color:#999;
                class NAT_GW,Priv_Sub removed

                %% Network Flow
                RT_Public -- "0.0.0.0/0" --> IGW
                IGW <--> Internet
            end
        end
    end
